# Copy this file to `.env` before running `npm run api:start` or `npm run api:mcp`.
# The values below are safe defaults for local development.

# -----------------------------------------------------------------------------
# LLM Runtime
# -----------------------------------------------------------------------------
# Leave LLM_API_KEY empty to stay in deterministic local fallback mode.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
LLM_MODEL=GLM-4.7

# -----------------------------------------------------------------------------
# Concept Extraction Strategy
# -----------------------------------------------------------------------------
# rules  = deterministic extraction only
# llm    = LLM extraction only, falls back to rules if key is unavailable
# hybrid = rules + LLM merge, recommended for day-to-day usage
KNOWLEDGE_CONCEPT_STRATEGY=hybrid

# -----------------------------------------------------------------------------
# Retrieval / Ranking
# -----------------------------------------------------------------------------
# Enable local embedding rerank with Xenova/bge-small-zh-v1.5.
# This improves search/query quality but adds warm-up cost on first use.
ENABLE_VECTOR_SEARCH=0
VECTOR_SEARCH_RERANK_CANDIDATES=24

# -----------------------------------------------------------------------------
# Nanobot Maintenance Guardrails
# -----------------------------------------------------------------------------
# Nanobot is opt-in. Start with dry-run so you can observe behavior safely.
NANOBOT_ENABLED=0
NANOBOT_DRY_RUN=1
NANOBOT_INTERVAL_MS=30000
NANOBOT_BRAINSTORM_CHANCE=0.08
NANOBOT_RECONCILE_CHANCE=0.08

# -----------------------------------------------------------------------------
# Optional Runtime Hints
# -----------------------------------------------------------------------------
# CODEX_RUNTIME_MODE is informational and can help `/health` reflect your setup.
CODEX_RUNTIME_MODE=local-fallback

# -----------------------------------------------------------------------------
# Recommended Presets
# -----------------------------------------------------------------------------
# 1) Safe Local:
#    LLM_API_KEY=
#    KNOWLEDGE_CONCEPT_STRATEGY=rules
#    ENABLE_VECTOR_SEARCH=0
#    NANOBOT_ENABLED=0
#
# 2) Balanced Hybrid (Recommended):
#    LLM_API_KEY=<your_key>
#    KNOWLEDGE_CONCEPT_STRATEGY=hybrid
#    ENABLE_VECTOR_SEARCH=1
#    VECTOR_SEARCH_RERANK_CANDIDATES=24
#    NANOBOT_ENABLED=1
#    NANOBOT_DRY_RUN=1
#
# 3) Fully Automated Lab:
#    LLM_API_KEY=<your_key>
#    KNOWLEDGE_CONCEPT_STRATEGY=hybrid
#    ENABLE_VECTOR_SEARCH=1
#    NANOBOT_ENABLED=1
#    NANOBOT_DRY_RUN=0
#    NANOBOT_INTERVAL_MS=60000
